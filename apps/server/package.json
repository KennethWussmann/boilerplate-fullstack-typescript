{
  "name": "server",
  "private": true,
  "version": "1.0.0",
  "description": "",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "scripts": {
    "dev": "pnpm codegen && tsx watch src/run.ts",
    "build": "pnpm codegen && tsc && tsc-alias && pnpm copy-graphql",
    "build:watch": "pnpm codegen && tsc --watch",
    "copy-graphql": "cd src && find . -name '*.graphql' -exec sh -c 'mkdir -p ../dist/$(dirname {}) && cp {} ../dist/{}' \\;",
    "codegen": "graphql-codegen && tsx scripts/update-config-options-doc.ts",
    "drizzle-kit": "CONFIG_JSON=$(tsx --no-warnings './scripts/print-config.ts') drizzle-kit",
    "db:migrate": "pnpm drizzle-kit migrate --config=drizzle.config.ts",
    "db:push": "pnpm drizzle-kit push --config=drizzle.config.ts",
    "db:generate": "pnpm drizzle-kit generate --config=drizzle.config.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset-db.ts && pnpm db:migrate && pnpm db:seed",
    "db:clear": "tsx scripts/reset-db.ts && pnpm db:migrate",
    "gql": "tsx scripts/gql.ts"
  },
  "files": [
    "dist/",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/graphql-modules-preset": "^6.1.3",
    "@graphql-codegen/schema-ast": "^6.1.1",
    "@graphql-codegen/typescript-resolvers": "^6.1.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "tsc-alias": "^1.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@bull-board/api": "^9.10.5",
    "@bull-board/express": "^9.10.5",
    "@envelop/graphql-modules": "^10.0.0",
    "@graphql-tools/load-files": "^8.0.6",
    "bullmq": "^6.4.0",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "glob": "^13.0.6",
    "graphql": "^17.0.2",
    "graphql-modules": "3.1.2",
    "graphql-scalars": "^2.0.1",
    "graphql-ws": "^6.4.1",
    "graphql-yoga": "^6.0.0",
    "ioredis": "^6.0.0",
    "parse-duration": "^2.1.9",
    "postgres": "^3.4.9",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "winston-transport": "^4.9.0",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}